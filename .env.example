# Esta es la URL base de tu backend de Django que se usará para todas las peticiones API.
# Cuando despliegues el frontend en plataformas como Vercel o en Coolify,
# debes añadir esta misma variable en los ajustes del proyecto/entorno.
VITE_API_URL=http://178.156.245.214/api

# Para entorno local de desarrollo (cuando corras npm run dev localmente), 
# la aplicación usa http://localhost:8000/api por defecto si esta variable no existe,
# pero también puedes crear un archivo `.env.local` con:
# VITE_API_URL=http://localhost:8000/api
